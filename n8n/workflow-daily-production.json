{
  "name": "Autogram - Daily Production Engine",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "schedule-trigger",
      "name": "Schedule - 06:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "python orchestrator.py --dry-run"
      },
      "id": "execute-orchestrator",
      "name": "Execute Content Engine",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.exitCode }}",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-success",
      "name": "Check Exit Code",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [720, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "✅ Autogram: Daily carousel generated and staged successfully for today's posting slot."
      },
      "id": "notify-success",
      "name": "Telegram Alert - Success",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "⚠️ Autogram Alert: Daily carousel generation failed. Review logs."
      },
      "id": "notify-failure",
      "name": "Telegram Alert - Failure",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [960, 400]
    }
  ],
  "connections": {
    "Schedule - 06:00 AM": {
      "main": [
        [
          {
            "node": "Execute Content Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Execute Content Engine": {
      "main": [
        [
          {
            "node": "Check Exit Code",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Exit Code": {
      "main": [
        [
          {
            "node": "Telegram Alert - Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Telegram Alert - Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
