# ==========================================
# LLM ENGINE (100% FREE OPTIONS SUPPORTED)
# ==========================================
# 1. Google Gemini (100% FREE - 1,500 requests/day): https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Groq Cloud (100% FREE ultra-fast Llama 3.3 70B): https://console.groq.com/
GROQ_API_KEY=

# 3. GitHub Copilot / GitHub Models (100% FREE GPT-4o & Llama 3.1): Personal Access Token
GITHUB_COPILOT_TOKEN=

# 4. Ollama (100% FREE local model on your PC, 0 cost): http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# 5. OpenRouter :free tier (viral Reels scripts, zero cost, no card): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# 6. Hugging Face (ZeroGPU video + inference, free token): https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
HF_TOKEN=

# 5. Optional Paid LLMs (if desired):
OPENAI_API_KEY=
CLAUDE_API_KEY=

# 5. Video Generation & AI Cinematic Video Engines
# Hugging Face ZeroGPU (Wan 2.1 / LTX-Video) uses HF_TOKEN from above.
JSON2VIDEO_API_KEY=
FAL_KEY=
APIFRAME_API_KEY=
PEXELS_API_KEY=
MPT_BASE_URL=http://127.0.0.1:8080

# Provider selection: auto | gemini | groq | ollama | builtin | openai | claude
# 'auto' will automatically pick whichever free or configured key is available!
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.0-flash

# ==========================================
# AI IMAGE GENERATION (HERO & CONCEPT VISUALS)
# ==========================================
# 1. Pollinations FLUX.1 [schnell] (100% FREE, Zero Keys, Zero Cost): Default
# 2. Google Imagen 3 (Uses GEMINI_API_KEY from above, Free Tier)
# 3. OpenAI DALL-E 3 (Uses OPENAI_API_KEY, Paid)
IMAGE_PROVIDER=pollinations
IMAGE_STYLE=cyber-minimalist

# Meta Instagram Graph API
# Requires Professional (Creator/Business) account with instagram_business_content_publish scope
IG_USER_ID=
IG_ACCESS_TOKEN=
META_API_VERSION=v23.0
# Spec aliases for scripts/publish_instagram.py (either pair works)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_GRAPH_ACCESS_TOKEN=

# Reels public CDN (Meta crawler needs HTTPS; engine falls back to free hosts)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_REELS_BUCKET=reels-cdn
REELS_VOICE=en-US-ChristopherNeural

# Storage (S3 / Cloudflare R2 / AWS / Cloudinary)
# Leave empty to use local static server / local filesystem staging
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
PUBLIC_CDN_BASE=http://localhost:8000
# Free authenticated public image host fallback (avoids CI timeouts on free public hosts)
IMGBB_API_KEY=

# Database
# Leave blank for default local SQLite database (autopilot.db)
DATABASE_URL=sqlite:///autopilot.db

# Scheduling & Timezone
TIMEZONE=Asia/Kolkata
POSTING_TIME=19:30

# Failure Alerts (Optional Slack or Telegram webhook)
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Operating Mode
# Set DRY_RUN=true to test without publishing to Meta
DRY_RUN=true

# Monetization & Access Control (Owner Free VIP Access vs Paid Client Licensing)
# Set your private Master Key for 100% free, unlimited, permanent access in Web & CLI
AUTOGRAM_OWNER_KEY=autogram_owner_vip_2026
AUTOGRAM_SECRET_SALT=autogram_master_monetization_secret_2026_salt
# Client License Key (leave blank if running as Owner, or populate if deploying for a paid client)
AUTOGRAM_CLIENT_KEY=
# UPI Payment & WhatsApp Confirmation Details
UPI_ID=6202442690@jio
WHATSAPP_NUMBER=6202442690
# Stripe Payment / Checkout Links for Client Subscription Tiers ($0 Setup Cost)
# These override the per-tier stripe_url in data/pricing.json (the canonical pricing source).
# Leave empty/placeholder until real Stripe Payment Links are created.
STRIPE_STARTER_URL=
STRIPE_GROWTH_URL=
STRIPE_ENTERPRISE_URL=

# ==========================================
# MAKERZZ P0-P8 ENGINE (ADDITIVE — optional multi-platform adapters)
# ==========================================
# Ayrshare: optional 13-platform enterprise dispatch (Instagram, YouTube, LinkedIn,
# TikTok, Facebook, Threads, X, Pinterest, Bluesky, Reddit, Telegram, Discord, GBP).
# Leave blank to use Direct Meta Mode (Instagram via Meta Graph API only).
AYRSHARE_API_KEY=
# HeyGen: optional talking-avatar video provider for the P4 lane.
# Leave blank to use the internal zero-cost Edge-TTS + MPT pipeline.
HEYGEN_API_KEY=
# Apify: optional competitor profile scraping for the P1 scan.
# Leave blank to supply profile data manually via the brief JSON.
APIFY_API_KEY=


