# Virtual Environment
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# Environment secrets
.env
!.env.example

# Runtime DB & outputs
*.db
# NOTE: this `output/` is UNANCHORED, so it matches video_studio/output/ too.
# That is wrong for video studio — the rendered demo artifacts are part of the
# deliverable and must stay tracked. Re-include them below.
output/
!video_studio/output/
workspace/*
!workspace/.gitkeep
scratch/
.pytest_cache/
runs/
assets/download/

# Node
node_modules/
npm-debug.log

# ==========================================
# Video Studio scratch + generated artifacts
# ==========================================

# Scratch render probes at repo root. Disposable debugging output from
# ad-hoc ffmpeg / hyperframes runs; never a deliverable.
tmp_*.mp4
tmp_*.log
tmp_*.png
tmp_*.webm
tmp_*.json

# Ad-hoc experiment dirs. The repo-root `scratch/` rule above already covers
# scratch/; smoke/ is the HyperFrames QA playground (`hyperframes init smoke`).
smoke/

# HyperFrames project dir. write_project() does shutil.rmtree() on it and
# rebuilds it from video_studio/briefs/<slug>.json on every build and render,
# so it carries no information that is not already in the brief.
video_studio/work/

# Per-scene wavs + the concatenated narration track. Regenerated by
# `cli.py render --audio`; the muxed audio is already inside reel.mp4.
# NOTE: the rest of video_studio/output/ is deliberately NOT ignored —
# the rendered demo artifacts are part of the deliverable.
video_studio/output/*/audio/

# Kokoro TTS model weights (~340MB: kokoro-v1.0.onnx ~310MB + voices-v1.0.bin
# ~27MB). MUST NOT be committed. Re-fetch with:
#   curl -L -o models/kokoro/kokoro-v1.0.onnx \
#     https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/kokoro-v1.0.onnx
#   curl -L -o models/kokoro/voices-v1.0.bin \
#     https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/voices-v1.0.bin
# See docs/video-studio/05_SETUP_AND_INSTALLATION.md for the full step.
models/

.vercel
temp_guide.html
*.zip
daily-carousel-artifacts/
.firecrawl/
.codebase-memory/
.kilo/
.kilocode/
