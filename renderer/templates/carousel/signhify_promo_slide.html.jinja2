    <!-- Bottom Footer Bar -->
    <footer class="footer-bar">
      <div class="footer-left">
        <div class="footer-dot"></div>
        <span>@signhify.studio · signhify.dpdns.org</span>
      </div>
      <div class="footer-swipe-action">
        {% if is_last_slide %}
        <span>Save Post 🔖</span>
        {% else %}
        <span>Swipe ➔</span>
        {% endif %}
      </div>
    </footer>
  </div>
