<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=1350, initial-scale=1.0">
  <title>Signhify Studio Carousel Slide</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800;900&family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    body {
      width: 1080px;
      height: 1350px;
      background-color: #020617;
      color: #F8FAFC;
      font-family: 'Plus Jakarta Sans', sans-serif;
      overflow: hidden;
      position: relative;
    }

    /* Ambient Lighting & Background Cyber Grid */
    .bg-grid {
      position: absolute;
      inset: 0;
      background-image: 
        radial-gradient(circle at 50% -10%, rgba(0, 229, 153, 0.25) 0%, transparent 60%),
        radial-gradient(circle at 90% 80%, rgba(6, 182, 212, 0.15) 0%, transparent 50%),
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      background-size: 100% 100%, 100% 100%, 54px 54px, 54px 54px;
      z-index: 0;
    }

    .ambient-orb-top {
      position: absolute;
      top: -120px;
      left: 50%;
      transform: translateX(-50%);
      width: 700px;
      height: 400px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 229, 153, 0.3) 0%, rgba(6, 182, 212, 0.1) 50%, transparent 80%);
      filter: blur(80px);
      z-index: 1;
      pointer-events: none;
    }

    .ambient-orb-bottom {
      position: absolute;
      bottom: -80px;
      right: -80px;
      width: 500px;
      height: 500px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 229, 153, 0.2) 0%, transparent 70%);
      filter: blur(90px);
      z-index: 1;
      pointer-events: none;
    }

    /* Outer Container with Standard Safe Margins */
    .slide-wrapper {
      position: relative;
      z-index: 10;
      width: 1080px;
      height: 1350px;
      padding: 70px 60px 65px 60px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Top Header Bar */
    .header-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
    }

    .brand-identity {
      display: flex;
      align-items: center;
      gap: 18px;
    }

    .logo-avatar {
      width: 62px;
      height: 62px;
      border-radius: 16px;
      border: 2px solid #00E599;
      box-shadow: 0 0 20px rgba(0, 229, 153, 0.4);
      background: #020617;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }

    .logo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .brand-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .brand-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px;
      font-weight: 900;
      letter-spacing: 2px;
      color: #FFFFFF;
      text-transform: uppercase;
    }

    .brand-tagline {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px;
      font-weight: 700;
      color: #00E599;
      letter-spacing: 1.5px;
    }

    .slide-counter-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 900;
      padding: 10px 24px;
      background: rgba(15, 23, 42, 0.85);
      border: 1.5px solid rgba(0, 229, 153, 0.5);
      border-radius: 999px;
      color: #00E599;
      box-shadow: 0 0 15px rgba(0, 229, 153, 0.2);
    }

    /* Main Body Area */
    .content-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 40px 0;
      position: relative;
    }

    /* Common Card Styling */
    .glass-card {
      background: rgba(15, 23, 42, 0.78);
      backdrop-filter: blur(24px);
      border: 1.5px solid rgba(0, 229, 153, 0.35);
      border-radius: 32px;
      padding: 44px;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), inset 0 0 30px rgba(0, 229, 153, 0.05);
      position: relative;
    }

    /* Category / Eyebrow Badge */
    .eyebrow-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 22px;
      background: rgba(0, 229, 153, 0.15);
      border: 1px solid #00E599;
      border-radius: 999px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 800;
      color: #00E599;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 24px;
      width: fit-content;
      box-shadow: 0 0 16px rgba(0, 229, 153, 0.25);
    }

    /* Titles */
    .slide-headline {
      font-size: 58px;
      font-weight: 900;
      line-height: 1.15;
      color: #FFFFFF;
      letter-spacing: -1.5px;
      margin-bottom: 20px;
    }

    .slide-headline span.highlight {
      background: linear-gradient(135deg, #00E599 0%, #06B6D4 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .slide-subtext {
      font-size: 26px;
      line-height: 1.45;
      color: #CBD5E1;
      font-weight: 600;
      margin-bottom: 34px;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: HOOK (SLIDE 1) */
    /* ======================================================== */
    .hook-body {
      display: flex;
      flex-direction: column;
    }

    .terminal-box {
      background: #090E1F;
      border: 1.5px solid rgba(0, 229, 153, 0.4);
      border-radius: 24px;
      overflow: hidden;
      margin-top: 15px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
    }

    .terminal-bar {
      background: #0F172A;
      padding: 14px 22px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .terminal-dots {
      display: flex;
      gap: 9px;
    }

    .t-dot {
      width: 14px;
      height: 14px;
      border-radius: 50%;
    }
    .t-dot-red { background: #EF4444; }
    .t-dot-yellow { background: #F59E0B; }
    .t-dot-green { background: #10B981; }

    .terminal-title {
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 700;
      color: #94A3B8;
      letter-spacing: 1px;
    }

    .terminal-content {
      padding: 30px;
      font-family: 'JetBrains Mono', monospace;
    }

    .prompt-label {
      font-size: 15px;
      font-weight: 700;
      color: #00E599;
      text-transform: uppercase;
      letter-spacing: 1.5px;
      margin-bottom: 12px;
    }

    .prompt-text {
      font-size: 22px;
      line-height: 1.5;
      color: #FFFFFF;
      font-weight: 600;
      border-left: 3px solid #00E599;
      padding-left: 18px;
    }

    .terminal-status-row {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 16px;
      font-weight: 700;
      color: #64748B;
    }

    .status-pill {
      background: rgba(0, 229, 153, 0.15);
      border: 1px solid #00E599;
      color: #00E599;
      padding: 6px 16px;
      border-radius: 999px;
      font-size: 14px;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: COMPARISON (SLIDE 2) */
    /* ======================================================== */
    .compare-cards-container {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .compare-block {
      border-radius: 26px;
      padding: 32px 36px;
      position: relative;
    }

    .compare-block.bad {
      background: rgba(30, 27, 40, 0.7);
      border: 1.5px solid rgba(239, 68, 68, 0.4);
    }

    .compare-block.good {
      background: rgba(6, 40, 30, 0.75);
      border: 2px solid #00E599;
      box-shadow: 0 0 35px rgba(0, 229, 153, 0.25);
    }

    .compare-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .compare-block.bad .compare-tag { color: #EF4444; }
    .compare-block.good .compare-tag { color: #00E599; }

    .compare-hero-metric {
      font-size: 42px;
      font-weight: 900;
      letter-spacing: -1px;
      margin-bottom: 18px;
    }

    .compare-block.bad .compare-hero-metric { color: #FCA5A5; }
    .compare-block.good .compare-hero-metric { color: #FFFFFF; }

    .compare-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .compare-list li {
      font-size: 21px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .compare-block.bad .compare-list li { color: #CBD5E1; }
    .compare-block.good .compare-list li { color: #F1F5F9; }

    .bullet-cross { color: #EF4444; font-weight: 900; font-size: 22px; }
    .bullet-check { color: #00E599; font-weight: 900; font-size: 22px; }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: ARCHITECTURE (SLIDE 3) */
    /* ======================================================== */
    .arch-flow {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .arch-step-card {
      background: rgba(15, 23, 42, 0.7);
      border: 1.5px solid rgba(0, 229, 153, 0.3);
      border-radius: 20px;
      padding: 22px 28px;
      display: flex;
      align-items: center;
      gap: 24px;
    }

    .arch-step-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 26px;
      font-weight: 900;
      color: #00E599;
      background: rgba(0, 229, 153, 0.15);
      border: 1.5px solid #00E599;
      border-radius: 14px;
      width: 58px;
      height: 58px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .arch-step-info h3 {
      font-size: 24px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 4px;
    }

    .arch-step-info p {
      font-size: 19px;
      color: #94A3B8;
      font-weight: 600;
      line-height: 1.4;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: FEATURES (SLIDE 4) */
    /* ======================================================== */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .bento-card {
      background: rgba(15, 23, 42, 0.7);
      border: 1.5px solid rgba(0, 229, 153, 0.3);
      border-radius: 24px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 240px;
    }

    .bento-icon-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 15px;
      font-weight: 800;
      padding: 6px 14px;
      background: rgba(0, 229, 153, 0.15);
      border: 1px solid #00E599;
      border-radius: 8px;
      color: #00E599;
      width: fit-content;
    }

    .bento-card h3 {
      font-size: 25px;
      font-weight: 800;
      color: #FFFFFF;
      line-height: 1.25;
      margin: 12px 0 6px 0;
    }

    .bento-card p {
      font-size: 18px;
      color: #94A3B8;
      font-weight: 600;
      line-height: 1.35;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: PROOF & BENCHMARKS (SLIDE 5) */
    /* ======================================================== */
    .stat-cards-vertical {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .stat-row-card {
      background: rgba(15, 23, 42, 0.75);
      border: 1.5px solid rgba(0, 229, 153, 0.35);
      border-radius: 22px;
      padding: 24px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-left {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .stat-title {
      font-size: 25px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .stat-description {
      font-size: 18px;
      color: #94A3B8;
      font-weight: 600;
    }

    .stat-number-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 46px;
      font-weight: 900;
      color: #00E599;
      text-shadow: 0 0 25px rgba(0, 229, 153, 0.45);
    }

    .proof-quote {
      background: rgba(0, 229, 153, 0.08);
      border-left: 4px solid #00E599;
      padding: 20px 24px;
      border-radius: 0 16px 16px 0;
      margin-top: 15px;
      font-size: 20px;
      font-weight: 600;
      color: #CBD5E1;
      font-style: italic;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: QUICKSTART ROADMAP (SLIDE 6) */
    /* ======================================================== */
    .roadmap-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .roadmap-item {
      background: rgba(15, 23, 42, 0.7);
      border: 1.5px solid rgba(0, 229, 153, 0.3);
      border-radius: 20px;
      padding: 22px 28px;
      display: flex;
      align-items: center;
      gap: 22px;
    }

    .roadmap-step-badge {
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 900;
      color: #020617;
      background: #00E599;
      border-radius: 12px;
      padding: 8px 16px;
      flex-shrink: 0;
    }

    .roadmap-text h3 {
      font-size: 23px;
      font-weight: 800;
      color: #FFFFFF;
      margin-bottom: 4px;
    }

    .roadmap-text p {
      font-size: 18px;
      color: #94A3B8;
      font-weight: 600;
    }

    /* ======================================================== */
    /* LAYOUT SPECIFICS: CTA HERO (SLIDE 7) */
    /* ======================================================== */
    .cta-hero-wrapper {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 22px;
    }

    .cta-radar-logo {
      position: relative;
      width: 150px;
      height: 150px;
      margin-bottom: 8px;
    }

    .cta-logo-img {
      position: relative;
      z-index: 5;
      width: 150px;
      height: 150px;
      border-radius: 36px;
      border: 3px solid #00E599;
      box-shadow: 0 0 45px rgba(0, 229, 153, 0.6);
      object-fit: cover;
    }

    .cta-pulse {
      position: absolute;
      inset: -20px;
      border-radius: 46px;
      border: 2px solid rgba(0, 229, 153, 0.4);
      pointer-events: none;
    }

    .cta-url-box {
      background: linear-gradient(135deg, #00E599 0%, #06B6D4 100%);
      padding: 24px 44px;
      border-radius: 20px;
      width: 100%;
      box-shadow: 0 15px 40px rgba(0, 229, 153, 0.4);
    }

    .cta-url-text {
      font-family: 'JetBrains Mono', monospace;
      font-size: 38px;
      font-weight: 900;
      color: #020617;
      letter-spacing: 1px;
    }

    .comment-trigger-card {
      background: rgba(0, 229, 153, 0.12);
      border: 2px dashed #00E599;
      border-radius: 24px;
      padding: 24px 34px;
      width: 100%;
    }

    .comment-trigger-title {
      font-size: 26px;
      font-weight: 900;
      color: #FFFFFF;
      margin-bottom: 8px;
    }

    .trigger-word {
      background: #00E599;
      color: #020617;
      padding: 4px 18px;
      border-radius: 8px;
      font-family: 'JetBrains Mono', monospace;
      font-weight: 900;
    }

    .comment-trigger-desc {
      font-size: 19px;
      color: #CBD5E1;
      font-weight: 600;
      line-height: 1.4;
    }

    /* Bottom Footer Bar */
    .footer-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .footer-left {
      display: flex;
      align-items: center;
      gap: 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 700;
      color: #94A3B8;
    }

    .footer-dot {
      width: 8px;
      height: 8px;
      background: #00E599;
      border-radius: 50%;
      box-shadow: 0 0 10px #00E599;
    }

    .footer-swipe-action {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      font-weight: 800;
      color: #00E599;
      letter-spacing: 1px;
    }
  </style>
</head>
<body>
  <div class="bg-grid"></div>
  <div class="ambient-orb-top"></div>
  <div class="ambient-orb-bottom"></div>

  <div class="slide-wrapper">
    <!-- Top Header Bar -->
    <header class="header-bar">
      <div class="brand-identity">
        <div class="logo-avatar">
          {% if logo_base64 %}
          <img src="{{ logo_base64 }}" class="logo-img" alt="Signhify Logo" />
          {% else %}
          <div style="font-size: 28px; font-weight: 900; color: #00E599;">S</div>
          {% endif %}
        </div>
        <div class="brand-text">
          <div class="brand-name">Signhify Studio</div>
          <div class="brand-tagline">Autonomous 3D Web Engine</div>
        </div>
      </div>
      <div class="slide-counter-badge">{{ slide_number_formatted }}</div>
    </header>

    <!-- Main Content Area -->
    <main class="content-area">
      {% if slide.layout == 'hook' %}
        <!-- SLIDE 1: VIRAL HOOK -->
        <div class="hook-body">
          <div class="eyebrow-badge">⚡ {{ slide.eyebrow|default('NEW REVOLUTION') }}</div>
          <h1 class="slide-headline">{{ slide.headline_html|safe }}</h1>
          <p class="slide-subtext">{{ slide.subtext }}</p>

          <div class="terminal-box">
            <div class="terminal-bar">
              <div class="terminal-dots">
                <div class="t-dot t-dot-red"></div>
                <div class="t-dot t-dot-yellow"></div>
                <div class="t-dot t-dot-green"></div>
              </div>
              <div class="terminal-title">SIGNHIFY PROMPT-TO-3D v2.4</div>
            </div>
            <div class="terminal-content">
              <div class="prompt-label">● Input Prompt</div>
              <div class="prompt-text">"{{ slide.terminal_prompt|default('Create an interactive 3D portfolio with smooth scroll camera physics and zero WebGL boilerplate.') }}"</div>
              <div class="terminal-status-row">
                <span>Compiler: Three.js + WebGL 2.0</span>
                <span class="status-pill">Ready to Deploy</span>
              </div>
            </div>
          </div>
        </div>

      {% elif slide.layout == 'comparison' %}
        <!-- SLIDE 2: COMPARISON -->
        <div class="eyebrow-badge">⚡ {{ slide.eyebrow|default('THE REALITY CHECK') }}</div>
        <h1 class="slide-headline">{{ slide.headline_html|safe }}</h1>

        <div class="compare-cards-container">
          <div class="compare-block bad">
            <div class="compare-tag">✕ Traditional 3D Web Development</div>
            <div class="compare-hero-metric">$5,000+ & 4-6 Weeks</div>
            <ul class="compare-list">
              <li><span class="bullet-cross">✕</span> Endless Three.js boilerplate & camera math</li>
              <li><span class="bullet-cross">✕</span> Painful revisions & high agency retainer fees</li>
              <li><span class="bullet-cross">✕</span> Sluggish mobile FPS with heavy battery drain</li>
            </ul>
          </div>

          <div class="compare-block good">
            <div class="compare-tag">✓ Signhify Studio Engine</div>
            <div class="compare-hero-metric">$0 & 10 Minutes</div>
            <ul class="compare-list">
              <li><span class="bullet-check">✓</span> 1 English prompt -> Complete 3D scroll scene</li>
              <li><span class="bullet-check">✓</span> 60 FPS mobile-optimized WebGL canvas</li>
              <li><span class="bullet-check">✓</span> 1-Click Clean MIT ZIP export (deploy anywhere)</li>
            </ul>
          </div>
        </div>

      {% elif slide.layout == 'architecture' %}
        <!-- SLIDE 3: ARCHITECTURE BLUEPRINT -->
        <div class="eyebrow-badge">⚡ {{ slide.eyebrow|default('SYSTEM ARCHITECTURE') }}</div>
        <h1 class="slide-headline">{{ slide.headline_html|safe }}</h1>
        <p class="slide-subtext">{{ slide.subtext }}</p>

        <div class="arch-flow">
          <div class="arch-step-card">
            <div class="arch-step-num">01</div>
            <div class="arch-step-info">
              <h3>Spatial Intent Engine</h3>
              <p>Translates natural language prompts into deterministic 3D scene graphs, lighting models, and physics meshes.</p>
            </div>
          </div>
          <div class="arch-step-card">
            <div class="arch-step-num">02</div>
            <div class="arch-step-info">
              <h3>WebGL Shader Synthesis</h3>
              <p>Generates high-performance fragment and vertex shaders optimized for mobile and desktop GPUs.</p>
            </div>
          </div>
          <div class="arch-step-card">
            <div class="arch-step-num">03</div>
            <div class="arch-step-info">
              <h3>Cinematic Camera Rig</h3>
              <p>Binds scroll velocity and touch gestures to buttery 60 FPS camera motion trajectories.</p>
            </div>
          </div>
          <div class="arch-step-card">
            <div class="arch-step-num">04</div>
            <div class="arch-step-info">
              <h3>Production Source Bundler</h3>
              <p>Exports zero-dependency, clean vanilla JS + Three.js code in a downloadable MIT zip package.</p>
            </div>
          </div>
        </div>

      {% elif slide.layout == 'features' %}
        <!-- SLIDE 4: BENTO FEATURE BREAKDOWN -->
        <div class="eyebrow-badge">⚡ {{ slide.eyebrow|default('CORE CAPABILITIES') }}</div>
        <h1 class="slide-headline">{{ slide.headline_html|safe }}</h1>
