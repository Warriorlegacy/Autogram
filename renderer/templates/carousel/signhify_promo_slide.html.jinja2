            </div>
          </div>
          <div class="roadmap-item">
            <div class="roadmap-step-badge">STEP 04</div>
            <div class="roadmap-text">
              <h3>Click "Download ZIP" & Deploy Live</h3>
              <p>Grab your clean production assets and deploy to Vercel, Netlify, or GitHub Pages in 30 seconds.</p>
            </div>
          </div>
        </div>

      {% elif slide.layout == 'cta' %}
        <!-- SLIDE 7: GRAND VIRAL CTA -->
        <div class="cta-hero-wrapper">
          <div class="cta-radar-logo">
            <div class="cta-pulse"></div>
            {% if logo_base64 %}
            <img src="{{ logo_base64 }}" class="cta-logo-img" alt="Signhify Logo" />
            {% else %}
            <div class="cta-logo-img" style="background:#064e3b; display:flex; align-items:center; justify-content:center; font-size:60px; color:#00E599; font-weight:900;">S</div>
