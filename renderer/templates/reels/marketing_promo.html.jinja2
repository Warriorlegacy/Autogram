<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ topic }}</title>
  <style>{{ theme_css|default('') }}
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700;800&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #020617;
      color: #F8FAFC;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    #stage {
      position: relative;
      width: 1080px;
      height: 1920px;
      background: radial-gradient(circle at 50% 12%, #064e3b 0%, #06261f 35%, #020617 80%);
      overflow: hidden;
    }

    /* Ambient Dynamic Glow Orbs */
    .glow-orb-1 {
      position: absolute;
      width: 850px;
      height: 850px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 229, 153, 0.28) 0%, rgba(0, 229, 153, 0) 70%);
      top: -120px;
      right: -200px;
      filter: blur(80px);
      z-index: 1;
      pointer-events: none;
    }

    .glow-orb-2 {
      position: absolute;
      width: 850px;
      height: 850px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, rgba(6, 182, 212, 0) 70%);
      bottom: 120px;
      left: -200px;
      filter: blur(90px);
      z-index: 1;
      pointer-events: none;
    }

    /* High-tech grid overlay */
    .tech-grid {
      position: absolute;
      inset: 0;
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(0, 229, 153, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0, 229, 153, 0.05) 1px, transparent 1px);
      z-index: 2;
      pointer-events: none;
    }

    /* Instagram Safe Zone Container */
    .safe-zone {
      position: absolute;
      top: 130px;
      left: 60px;
      right: 140px; /* Safe space on right for IG action buttons */
      bottom: 330px; /* Safe space at bottom for IG caption and audio */
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Top Brand Header Bar */
    .brand-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 8px 24px 8px 10px;
      background: rgba(6, 78, 59, 0.5);
      border: 1.5px solid rgba(0, 229, 153, 0.7);
      border-radius: 999px;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #FFFFFF;
      box-shadow: 0 0 24px rgba(0, 229, 153, 0.35);
    }

    .brand-header-logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      object-fit: cover;
      border: 1.5px solid rgba(0, 229, 153, 0.9);
      box-shadow: 0 0 16px rgba(0, 229, 153, 0.6);
    }

    .header-dot {
      width: 14px;
      height: 14px;
      background: #00E599;
      border-radius: 50%;
      box-shadow: 0 0 14px #00E599;
    }

    .live-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      color: #00E599;
      background: rgba(0, 229, 153, 0.12);
      padding: 8px 16px;
      border-radius: 10px;
      border: 1px solid rgba(0, 229, 153, 0.4);
      letter-spacing: 1px;
    }

    /* Scene Viewport */
    .scene-viewport {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 30px 0;
    }

    .scene {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transform: translateY(30px) scale(0.98);
      transition: opacity 0.35s ease;
    }

    .scene.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    /* Glassmorphic Core Card */
    .glass-card {
      background: rgba(10, 20, 30, 0.88);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1.5px solid rgba(0, 229, 153, 0.3);
      border-radius: 36px;
      padding: 50px 44px;
      box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.85), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    /* SCENE 1: HOOK */
    .hook-alert {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #EF4444;
      margin-bottom: 24px;
      background: rgba(239, 68, 68, 0.18);
      border: 1px solid rgba(239, 68, 68, 0.5);
      padding: 8px 20px;
      border-radius: 12px;
      width: fit-content;
    }

    .hook-title {
      font-size: 66px;
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -1.5px;
      margin-bottom: 24px;
      color: #FFFFFF;
      text-shadow: 0 4px 25px rgba(0, 0, 0, 0.8);
    }

    .hook-title .gradient-text {
      background: linear-gradient(135deg, #A7F3D0 0%, #00E599 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hook-sub {
      font-size: 32px;
      font-weight: 600;
      color: #E2E8F0;
      line-height: 1.45;
      margin-bottom: 36px;
    }

    /* Cyber Terminal Box in Hook */
    .prompt-terminal {
      background: #030712;
      border: 1px solid rgba(0, 229, 153, 0.4);
      border-radius: 20px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .terminal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      padding-bottom: 12px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      color: #00E599;
    }

    .terminal-body {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px;
      color: #F8FAFC;
      line-height: 1.4;
    }

    .terminal-body .prompt-tag {
      color: #00E599;
      font-weight: 800;
    }

    /* SCENE 2: COMPARISON */
    .compare-grid {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .compare-row {
      padding: 36px;
      border-radius: 24px;
    }

    .compare-old {
      background: rgba(239, 68, 68, 0.1);
      border: 1.5px solid rgba(239, 68, 68, 0.35);
    }

    .compare-new {
      background: rgba(0, 229, 153, 0.12);
      border: 1.5px solid rgba(0, 229, 153, 0.6);
      box-shadow: 0 0 40px rgba(0, 229, 153, 0.25);
    }

    .compare-label {
      font-size: 22px;
      font-weight: 800;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .compare-old .compare-label { color: #F87171; }
    .compare-new .compare-label { color: #00E599; }

    .compare-main {
      font-size: 42px;
      font-weight: 900;
      margin-bottom: 10px;
      color: #FFFFFF;
    }

    .compare-desc {
      font-size: 26px;
      color: #CBD5E1;
      line-height: 1.4;
    }

    /* SCENE 3: 3D PERSPECTIVE SHOWCASE */
    .mockup-window {
      background: rgba(11, 23, 36, 0.95);
      border: 2px solid rgba(0, 229, 153, 0.45);
      border-radius: 32px;
      overflow: hidden;
      box-shadow: 0 35px 80px rgba(0, 0, 0, 0.9), 0 0 50px rgba(0, 229, 153, 0.2);
    }

    .window-bar {
      height: 56px;
      background: #0F172A;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 12px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .dot-red { width: 16px; height: 16px; background: #EF4444; border-radius: 50%; }
    .dot-yellow { width: 16px; height: 16px; background: #F59E0B; border-radius: 50%; }
    .dot-green { width: 16px; height: 16px; background: #00E599; border-radius: 50%; }

    .window-url {
      flex: 1;
      margin-left: 20px;
      background: #030712;
      border-radius: 10px;
      padding: 8px 18px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 700;
      color: #00E599;
      text-align: center;
      border: 1px solid rgba(0, 229, 153, 0.35);
    }

    .mockup-content {
      padding: 40px 36px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    /* 3D Rotating Cube */
    .viewport-3d-stage {
      width: 100%;
      height: 250px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      overflow: visible;
    }

    .laser-scan {
      position: absolute;
      width: 280px;
      height: 3px;
      background: linear-gradient(90deg, transparent, #00E599, #06B6D4, transparent);
      box-shadow: 0 0 18px #00E599;
      animation: laserSweep 3s ease-in-out infinite;
      z-index: 5;
      pointer-events: none;
    }

    @keyframes laserSweep {
      0%, 100% { transform: translateY(-85px); opacity: 0.2; }
      50% { transform: translateY(85px); opacity: 1; }
    }

    .gyro-ring {
      position: absolute;
      width: 230px;
      height: 230px;
      border-radius: 50%;
      border: 1.5px dashed rgba(0, 229, 153, 0.45);
      pointer-events: none;
      transform-style: preserve-3d;
    }

    .gyro-ring-1 {
      animation: rotateGyro1 7s linear infinite;
    }

    .gyro-ring-2 {
      border-color: rgba(6, 182, 212, 0.45);
      animation: rotateGyro2 10s linear infinite reverse;
    }

    @keyframes rotateGyro1 {
      0% { transform: rotateX(65deg) rotateY(0deg); }
      100% { transform: rotateX(65deg) rotateY(360deg); }
    }

    @keyframes rotateGyro2 {
      0% { transform: rotateY(65deg) rotateZ(0deg); }
      100% { transform: rotateY(65deg) rotateZ(360deg); }
    }

    .cube-container {
      width: 150px;
      height: 150px;
      perspective: 900px;
      position: relative;
      z-index: 2;
    }

    .cube {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      animation: rotateCube 8s linear infinite;
    }

    @keyframes rotateCube {
      0% { transform: rotateX(-18deg) rotateY(0deg); }
      100% { transform: rotateX(-18deg) rotateY(360deg); }
    }

    .cube-face {
      position: absolute;
      width: 150px;
      height: 150px;
      border: 2px solid #00E599;
      background: rgba(2, 6, 23, 0.88);
      backdrop-filter: blur(10px);
      box-shadow: 0 0 30px rgba(0, 229, 153, 0.4), inset 0 0 20px rgba(0, 229, 153, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 20px;
      overflow: hidden;
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 900;
      color: #FFFFFF;
      letter-spacing: 1px;
    }

    .cube-logo-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .face-front  { transform: translateZ(75px); }
    .face-back   { transform: rotateY(180deg) translateZ(75px); }
    .face-right  { transform: rotateY(90deg) translateZ(75px); background: rgba(6, 40, 30, 0.9); }
    .face-left   { transform: rotateY(-90deg) translateZ(75px); background: rgba(6, 40, 30, 0.9); }
    .face-top    { transform: rotateX(90deg) translateZ(75px); background: rgba(0, 229, 153, 0.2); }
    .face-bottom { transform: rotateX(-90deg) translateZ(75px); background: rgba(0, 229, 153, 0.2); }

    .feature-pill-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .feature-pill {
      padding: 10px 20px;
      border-radius: 999px;
      font-size: 22px;
      font-weight: 800;
      background: rgba(0, 229, 153, 0.18);
      border: 1.5px solid rgba(0, 229, 153, 0.5);
      color: #FFFFFF;
    }

    .feature-title {
      font-size: 44px;
      font-weight: 900;
      line-height: 1.2;
      color: #FFFFFF;
    }

    .feature-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .feature-points li {
      font-size: 26px;
      font-weight: 600;
      color: #E2E8F0;
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .feature-points li span {
      color: #00E599;
      font-weight: 900;
      font-size: 28px;
    }

    /* SCENE 4: PROOF & METRICS */
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .stat-card {
      background: rgba(11, 22, 34, 0.9);
      border: 1.5px solid rgba(0, 229, 153, 0.35);
      border-radius: 26px;
      padding: 32px 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-num {
      font-size: 76px;
      font-weight: 900;
      letter-spacing: -2px;
      background: linear-gradient(135deg, #00E599, #38BDF8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }

    .stat-meta {
      text-align: right;
    }

    .stat-meta .stat-label {
      font-size: 30px;
      font-weight: 900;
      color: #FFFFFF;
    }

    .stat-meta .stat-sub {
      font-size: 22px;
      color: #94A3B8;
      margin-top: 4px;
    }

    /* SCENE 5: GRAND LOGO HERO & CTA */
    .cta-container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 26px;
    }

    .hero-logo-wrapper {
      position: relative;
      width: 190px;
      height: 190px;
      margin: 0 auto 10px auto;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .hero-logo-img {
      width: 180px;
      height: 180px;
      border-radius: 40px;
      object-fit: cover;
      border: 3px solid #00E599;
      box-shadow: 0 0 60px rgba(0, 229, 153, 0.7), 0 0 120px rgba(0, 229, 153, 0.3);
      position: relative;
      z-index: 3;
    }

    .hero-logo-fallback {
      width: 180px;
      height: 180px;
      border-radius: 40px;
      background: #064e3b;
      border: 3px solid #00E599;
      color: #00E599;
      font-size: 88px;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 3;
    }

    .pulse-ring {
      position: absolute;
      inset: -24px;
      border-radius: 52px;
      border: 2px solid rgba(0, 229, 153, 0.5);
      animation: pulse-ring 2.4s cubic-bezier(0.215, 0.61, 0.355, 1) infinite;
      pointer-events: none;
      z-index: 1;
    }

    .pulse-ring.ring-2 {
      animation-delay: 0.8s;
    }

    .pulse-ring.ring-3 {
      animation-delay: 1.6s;
    }

    @keyframes pulse-ring {
      0% {
        transform: scale(0.85);
        opacity: 0.95;
      }
      100% {
        transform: scale(1.7);
        opacity: 0;
      }
    }

    .cta-super {
      font-family: 'JetBrains Mono', monospace;
      font-size: 28px;
      font-weight: 900;
      color: #00E599;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-shadow: 0 0 20px rgba(0, 229, 153, 0.5);
    }

    .cta-headline {
      font-size: 56px;
      font-weight: 900;
      line-height: 1.15;
      color: #FFFFFF;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
    }

    .cta-box {
      width: 100%;
      background: linear-gradient(135deg, #00E599 0%, #06B6D4 100%);
      padding: 32px 40px;
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(0, 229, 153, 0.5);
      margin: 8px 0;
    }

    .cta-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 44px;
      font-weight: 900;
      color: #020617;
      letter-spacing: 0.5px;
    }

    .cta-comment-sticker {
      background: rgba(255, 255, 255, 0.1);
      border: 2px dashed rgba(0, 229, 153, 0.7);
      border-radius: 20px;
      padding: 20px 36px;
      font-size: 30px;
      font-weight: 800;
      color: #F8FAFC;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .cta-comment-sticker .key-word {
      background: #00E599;
      color: #020617;
      padding: 8px 22px;
      border-radius: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .cta-follow {
      font-size: 26px;
      color: #CBD5E1;
      font-weight: 700;
    }

    /* Subtitle Track Container & Per-Scene Subtitles */
    .sub-container {
      position: relative;
      height: 95px;
      width: 100%;
    }

    .sub-bar {
      position: absolute;
      inset: 0;
      padding: 16px 28px;
      background: rgba(2, 6, 23, 0.92);
      backdrop-filter: blur(16px);
      border: 1.5px solid rgba(0, 229, 153, 0.45);
      border-radius: 20px;
      font-size: 26px;
      font-weight: 800;
      text-align: center;
      color: #FFFFFF;
      line-height: 1.35;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      opacity: 0;
      visibility: hidden;
    }

    .sub-bar.active {
      opacity: 1;
      visibility: visible;
    }
  </style>
</head>
<body>
  <div id="stage" data-composition-id="marketing_reel" data-start="0" data-width="1080" data-height="1920" data-fps="25">
    <div class="glow-orb-1" id="orb-1"></div>
    <div class="glow-orb-2" id="orb-2"></div>
    <div class="tech-grid" id="bg-grid"></div>

    <!-- Instagram Safe Zone Wrapper -->
    <div class="safe-zone">
      
      <!-- Top Brand Header with Logo -->
      <div class="brand-header">
        <div class="brand-badge">
          {% if logo_file %}
          <img src="{{ logo_file }}" class="brand-header-logo" alt="Signhify Logo" />
          {% else %}
          <div class="header-dot"></div>
          {% endif %}
          <span>Signhify Studio</span>
        </div>
        <div class="live-tag">3D ENGINE • 60 FPS</div>
      </div>

      <!-- Main Animated Scene Viewport -->
      <div class="scene-viewport">
        
        <!-- SCENE 1: HOOK -->
        <div id="scene-hook" class="scene glass-card active clip" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}" data-track-index="1">
          <div class="hook-alert">⚡ {{ hook_alert|default('CRITICAL NOTICE') }}</div>
          <h1 class="hook-title"><span class="gradient-text">{{ hook_title }}</span></h1>
          <p class="hook-sub">{{ scene1_narration }}</p>
          
          <div class="prompt-terminal">
            <div class="terminal-header">
              <div style="display: flex; align-items: center; gap: 10px;">
                {% if logo_file %}
                <img src="{{ logo_file }}" style="width: 26px; height: 26px; border-radius: 6px; border: 1px solid #00E599; object-fit: cover;" alt="Logo" />
                {% endif %}
                <span>● PROMPT-TO-3D ENGINE</span>
              </div>
              <span>v2.4 READY</span>
            </div>
            <div class="terminal-body">
              <span class="prompt-tag">&gt; </span>"{{ scene1_narration }}"
            </div>
          </div>
        </div>

        <!-- SCENE 2: COMPARISON -->
        <div id="scene-compare" class="scene glass-card clip" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}" data-track-index="1">
          <div class="compare-grid">
            <div class="compare-row compare-old">
              <div class="compare-label">✕ Traditional Agencies</div>
              <div class="compare-main">$5,000 & 4 Weeks</div>
              <div class="compare-desc">Heavy Three.js boilerplate, painful revisions, no code ownership.</div>
            </div>
            <div class="compare-row compare-new">
              <div class="compare-label">✓ Signhify AI Engine</div>
              <div class="compare-main">1 Prompt & 10 Minutes</div>
              <div class="compare-desc">{{ scene2_narration }}</div>
            </div>
          </div>
        </div>

        <!-- SCENE 3: SHOWCASE & 3D WIREFRAME MOCKUP -->
        <div id="scene-showcase" class="scene clip" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}" data-track-index="1">
          <div class="mockup-window">
            <div class="window-bar">
              <div class="dot-red"></div>
              <div class="dot-yellow"></div>
              <div class="dot-green"></div>
              <div class="window-url">https://signhify.dpdns.org</div>
            </div>
            <div class="mockup-content">
              <!-- Live 3D rotating geometry with Signhify Logo & Gyroscope -->
              <div class="viewport-3d-stage">
                <div class="laser-scan"></div>
                <div class="gyro-ring gyro-ring-1"></div>
                <div class="gyro-ring gyro-ring-2"></div>
                <div class="cube-container">
                  <div class="cube">
                    <div class="cube-face face-front">
                      {% if logo_file %}
                      <img src="{{ logo_file }}" class="cube-logo-img" alt="Signhify Logo" />
                      {% else %}
                      <span>3D WEB</span>
                      {% endif %}
                    </div>
                    <div class="cube-face face-back">
                      {% if logo_file %}
                      <img src="{{ logo_file }}" class="cube-logo-img" alt="Signhify Logo" />
                      {% else %}
                      <span>60 FPS</span>
                      {% endif %}
                    </div>
                    <div class="cube-face face-right">
                      <span style="color: #00E599; font-size: 18px;">60 FPS<br><small style="color: #fff; font-size: 13px;">GPU ACCEL</small></span>
                    </div>
                    <div class="cube-face face-left">
                      <span style="color: #06B6D4; font-size: 18px;">100%<br><small style="color: #fff; font-size: 13px;">MIT ZIP</small></span>
                    </div>
                    <div class="cube-face face-top">
                      <span style="color: #00E599; font-size: 14px;">SPATIAL</span>
                    </div>
                    <div class="cube-face face-bottom">
                      <span style="color: #00E599; font-size: 14px;">ENGINE</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="feature-pill-row">
                <div class="feature-pill">Three.js</div>
                <div class="feature-pill">WebGL Shaders</div>
                <div class="feature-pill">Scroll Triggers</div>
                <div class="feature-pill">Clean ZIP</div>
              </div>
              <h2 class="feature-title">Native 60 FPS 3D Canvas</h2>
              <p class="compare-desc" style="font-size: 24px; color: #E2E8F0; margin-top: 4px;">{{ scene3_narration }}</p>
            </div>
          </div>
        </div>

        <!-- SCENE 4: PROOF & METRICS -->
        <div id="scene-proof" class="scene glass-card clip" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}" data-track-index="1">
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-num">{{ proof_metric|default('3D') }}</div>
              <div class="stat-meta">
                <div class="stat-label">Interactive Depth</div>
                <div class="stat-sub">Spatial scroll vs flat 2D pages</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-num">60 FPS</div>
              <div class="stat-meta">
                <div class="stat-label">Silky Smooth Scroll</div>
                <div class="stat-sub">Zero browser stutter on mobile</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-num">100%</div>
              <div class="stat-meta">
                <div class="stat-label">Code Ownership</div>
                <div class="stat-sub">Deploy anywhere with no vendor lock-in</div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 5: GRAND LOGO HERO OUTRO & CALL TO ACTION -->
        <div id="scene-cta" class="scene glass-card clip" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}" data-track-index="1">
          <div class="cta-container">
            <!-- Animated Hero Logo Asset with Radar Pulse Rings -->
            <div class="hero-logo-wrapper">
              <div class="pulse-ring ring-1"></div>
              <div class="pulse-ring ring-2"></div>
              <div class="pulse-ring ring-3"></div>
              {% if logo_file %}
              <img src="{{ logo_file }}" class="hero-logo-img" alt="Signhify Logo" />
              {% else %}
              <div class="hero-logo-fallback">S</div>
              {% endif %}
            </div>

            <div class="cta-super">SIGNHIFY STUDIO</div>
            <h2 class="cta-headline">Build Your 3D Site Free Today</h2>
            <div class="cta-box">
              <div class="cta-url">signhify.dpdns.org</div>
            </div>
            <div class="cta-comment-sticker">
              <span>Comment <strong class="key-word">3D</strong> for direct link</span>
            </div>
            <div class="cta-follow">Follow @signhify.studio for daily AI tech architectures</div>
          </div>
        </div>

      </div>

      <!-- Spoken Caption Dynamic Tracks Container (Synchronized with each scene) -->
      <div class="sub-container">
        <div id="sub-1" class="sub-bar clip" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene1_narration }}"</span>
        </div>
        <div id="sub-2" class="sub-bar clip" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene2_narration }}"</span>
        </div>
        <div id="sub-3" class="sub-bar clip" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene3_narration }}"</span>
        </div>
        <div id="sub-4" class="sub-bar clip" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene4_narration }}"</span>
        </div>
        <div id="sub-5" class="sub-bar clip" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene5_narration }}"</span>
        </div>
      </div>

    </div>

    <!-- Seekable Voiceover Audio Track -->
    {% if audio_file %}
    <audio
      data-start="0"
      data-duration="{{ total_duration }}"
      data-track-index="0"
      data-volume="1.0"
      src="{{ audio_file }}"
    ></audio>
    {% endif %}

  </div>

  <!-- GSAP 3 Seekable Timeline Script -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <script>
    const sceneDurations = [
      {{ scene1_duration }},
      {{ scene2_duration }},
      {{ scene3_duration }},
      {{ scene4_duration }},
      {{ scene5_duration }}
    ];

    const scenes = [
      document.getElementById('scene-hook'),
      document.getElementById('scene-compare'),
      document.getElementById('scene-showcase'),
      document.getElementById('scene-proof'),
      document.getElementById('scene-cta')
    ];

    const subtitles = [
      document.getElementById('sub-1'),
      document.getElementById('sub-2'),
      document.getElementById('sub-3'),
      document.getElementById('sub-4'),
      document.getElementById('sub-5')
    ];

    const orb1 = document.getElementById('orb-1');
    const orb2 = document.getElementById('orb-2');
    const bgGrid = document.getElementById('bg-grid');

    const tl = gsap.timeline({ paused: true });

    let cumulativeTime = 0;
    scenes.forEach((scene, idx) => {
      const dur = sceneDurations[idx];
      const sub = subtitles[idx];
      
      // Animate scene in
      tl.to(scene, {
        opacity: 1,
        visibility: 'visible',
        y: 0,
        scale: 1,
        duration: 0.35,
        ease: 'power3.out'
      }, cumulativeTime);

      // Animate subtitle track in synchronously
      if (sub) {
        tl.to(sub, {
          opacity: 1,
          visibility: 'visible',
          y: 0,
          scale: 1,
          duration: 0.28,
          ease: 'power2.out'
        }, cumulativeTime);
      }

      // Background video / lighting alignment per scene
      if (idx === 0) {
        // Scene 1 Hook: High energy emerald & cyan pulse
        tl.to(orb1, { x: 50, y: 100, scale: 1.2, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.to(orb2, { x: -60, y: -80, scale: 1.1, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.from(scene.querySelector('.hook-title'), { y: 25, opacity: 0, duration: dur * 0.25 }, cumulativeTime + dur * 0.05);
        const promptTerm = scene.querySelector('.prompt-terminal');
        if (promptTerm) tl.from(promptTerm, { scale: 0.92, opacity: 0, duration: dur * 0.25 }, cumulativeTime + dur * 0.12);
      } else if (idx === 1) {
        // Scene 2 Compare: Shift orbs to contrast mode
        tl.to(orb1, { x: -80, y: 200, scale: 0.9, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.to(orb2, { x: 90, y: 50, scale: 1.3, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.from(scene.querySelectorAll('.compare-row'), { y: 20, opacity: 0, stagger: dur * 0.08, duration: dur * 0.25 }, cumulativeTime + dur * 0.05);
      } else if (idx === 2) {
        // Scene 3 Showcase: 3D perspective grid acceleration
        tl.to(orb1, { x: 120, y: -50, scale: 1.4, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.to(orb2, { x: -100, y: 150, scale: 1.1, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.from(scene.querySelector('.mockup-window'), { scale: 0.9, opacity: 0, duration: dur * 0.25, ease: 'power2.out' }, cumulativeTime + dur * 0.05);
        tl.from(scene.querySelectorAll('.feature-pill'), { scale: 0.85, opacity: 0, stagger: dur * 0.05, duration: dur * 0.2 }, cumulativeTime + dur * 0.12);
      } else if (idx === 3) {
        // Scene 4 Proof: Solid emerald energy blast
        tl.to(orb1, { x: -40, y: -100, scale: 1.25, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.to(orb2, { x: 80, y: -60, scale: 1.35, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.from(scene.querySelectorAll('.stat-card'), { x: -25, opacity: 0, stagger: dur * 0.08, duration: dur * 0.25 }, cumulativeTime + dur * 0.05);
      } else if (idx === 4) {
        // Scene 5 CTA: Radiant focus on logo center
        tl.to(orb1, { x: 0, y: 0, scale: 1.5, duration: dur, ease: 'sine.out' }, cumulativeTime);
        tl.to(orb2, { x: 0, y: 0, scale: 1.5, duration: dur, ease: 'sine.out' }, cumulativeTime);
        tl.from(scene.querySelector('.hero-logo-wrapper'), { scale: 0.4, rotation: -12, opacity: 0, duration: dur * 0.25, ease: 'back.out(1.8)' }, cumulativeTime + dur * 0.05);
        tl.from(scene.querySelector('.cta-headline'), { y: 20, opacity: 0, duration: dur * 0.2 }, cumulativeTime + dur * 0.12);
        tl.from(scene.querySelector('.cta-box'), { scale: 0.9, opacity: 0, duration: dur * 0.2, ease: 'back.out(1.5)' }, cumulativeTime + dur * 0.18);
        tl.from(scene.querySelector('.cta-comment-sticker'), { y: 15, opacity: 0, duration: dur * 0.2 }, cumulativeTime + dur * 0.24);
      }

      // Animate scene & subtitle out (except for the last scene)
      if (idx < scenes.length - 1) {
        const outTime = cumulativeTime + dur - 0.25;
        tl.to(scene, {
          opacity: 0,
          y: -20,
          scale: 0.98,
          duration: 0.25,
          ease: 'power2.in'
        }, outTime);
        if (sub) {
          tl.to(sub, {
            opacity: 0,
            y: 12,
            scale: 0.96,
            duration: 0.22,
            ease: 'power2.in'
          }, outTime);
        }
      }

      cumulativeTime += dur;
    });

    // Register seekable timeline for HyperFrames deterministic engine
    window.__timelines = window.__timelines || {};
    window.__timelines.marketing_reel = tl;
  </script>
</body>
</html>
