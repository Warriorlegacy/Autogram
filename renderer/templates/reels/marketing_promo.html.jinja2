<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ topic }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap');

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #030712;
      color: #F9FAFB;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    #stage {
      position: relative;
      width: 1080px;
      height: 1920px;
      background: radial-gradient(circle at 50% 20%, #1e1b4b 0%, #090d16 60%, #030712 100%);
      overflow: hidden;
    }

    /* Ambient dynamic glow orbs */
    .glow-orb-1 {
      position: absolute;
      width: 700px;
      height: 700px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.28) 0%, rgba(99, 102, 241, 0) 70%);
      top: -100px;
      right: -150px;
      filter: blur(60px);
      z-index: 1;
      pointer-events: none;
    }

    .glow-orb-2 {
      position: absolute;
      width: 800px;
      height: 800px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(6, 182, 212, 0.22) 0%, rgba(6, 182, 212, 0) 70%);
      bottom: 200px;
      left: -200px;
      filter: blur(80px);
      z-index: 1;
      pointer-events: none;
    }

    /* Grid overlay for tech aesthetic */
    .tech-grid {
      position: absolute;
      inset: 0;
      background-size: 60px 60px;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
      z-index: 2;
      pointer-events: none;
    }

    /* Instagram Safe Zone Container */
    .safe-zone {
      position: absolute;
      top: 140px;
      left: 60px;
      right: 140px; /* Safe space on the right for IG action buttons */
      bottom: 340px; /* Safe space at the bottom for IG caption & sound bar */
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    /* Header Bar */
    .brand-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 10px 22px;
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.4);
      border-radius: 999px;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: #A5B4FC;
    }

    .brand-badge .dot {
      width: 12px;
      height: 12px;
      background: #06B6D4;
      border-radius: 50%;
      box-shadow: 0 0 12px #06B6D4;
    }

    .live-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      color: #9CA3AF;
      letter-spacing: 1px;
    }

    /* Scene Containers */
    .scene-viewport {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 40px 0;
    }

    .scene {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transform: translateY(30px) scale(0.98);
      transition: opacity 0.4s ease;
    }

    .scene.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    /* Glassmorphism Card Style */
    .glass-card {
      background: rgba(17, 24, 39, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 28px;
      padding: 44px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.15);
    }

    /* Scene 1: Hook */
    .hook-alert {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #F43F5E;
      margin-bottom: 24px;
      background: rgba(244, 63, 94, 0.12);
      border: 1px solid rgba(244, 63, 94, 0.3);
      padding: 8px 18px;
      border-radius: 8px;
      width: fit-content;
    }

    .hook-title {
      font-size: 64px;
      font-weight: 900;
      line-height: 1.15;
      letter-spacing: -1.5px;
      margin-bottom: 28px;
      background: linear-gradient(135deg, #FFFFFF 20%, #E0E7FF 60%, #818CF8 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hook-sub {
      font-size: 32px;
      font-weight: 600;
      color: #94A3B8;
      line-height: 1.4;
    }

    /* Scene 2: Comparison (Old vs New) */
    .compare-grid {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .compare-row {
      padding: 32px;
      border-radius: 20px;
    }

    .compare-old {
      background: rgba(239, 68, 68, 0.08);
      border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .compare-new {
      background: rgba(16, 185, 129, 0.1);
      border: 1px solid rgba(16, 185, 129, 0.4);
      box-shadow: 0 0 30px rgba(16, 185, 129, 0.15);
    }

    .compare-label {
      font-size: 20px;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .compare-old .compare-label { color: #F87171; }
    .compare-new .compare-label { color: #34D399; }

    .compare-main {
      font-size: 40px;
      font-weight: 800;
      margin-bottom: 8px;
      color: #FFFFFF;
    }

    .compare-desc {
      font-size: 26px;
      color: #9CA3AF;
      line-height: 1.35;
    }

    /* Scene 3: Product / Feature Showcase */
    .mockup-window {
      background: #0F172A;
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 24px;
      overflow: hidden;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.7);
    }

    .window-bar {
      height: 48px;
      background: #1E293B;
      display: flex;
      align-items: center;
      padding: 0 20px;
      gap: 10px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .dot-red { width: 14px; height: 14px; background: #EF4444; border-radius: 50%; }
    .dot-yellow { width: 14px; height: 14px; background: #F59E0B; border-radius: 50%; }
    .dot-green { width: 14px; height: 14px; background: #10B981; border-radius: 50%; }

    .window-url {
      flex: 1;
      margin-left: 20px;
      background: #090D16;
      border-radius: 8px;
      padding: 6px 14px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px;
      color: #38BDF8;
      text-align: center;
    }

    .mockup-content {
      padding: 40px 32px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .feature-pill-row {
      display: flex;
      gap: 14px;
      flex-wrap: wrap;
    }

    .feature-pill {
      padding: 10px 18px;
      border-radius: 999px;
      font-size: 22px;
      font-weight: 700;
      background: rgba(99, 102, 241, 0.2);
      border: 1px solid rgba(99, 102, 241, 0.5);
      color: #C7D2FE;
    }

    .feature-title {
      font-size: 46px;
      font-weight: 800;
      line-height: 1.2;
      color: #FFFFFF;
      margin-top: 10px;
    }

    .feature-points {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-top: 10px;
    }

    .feature-points li {
      font-size: 26px;
      color: #CBD5E1;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .feature-points li span {
      color: #06B6D4;
      font-weight: 800;
    }

    /* Scene 4: Proof & Authority */
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .stat-card {
      background: rgba(15, 23, 42, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 20px;
      padding: 30px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-num {
      font-size: 72px;
      font-weight: 900;
      letter-spacing: -2px;
      background: linear-gradient(135deg, #06B6D4, #3B82F6);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }

    .stat-meta {
      text-align: right;
    }

    .stat-meta .stat-label {
      font-size: 28px;
      font-weight: 800;
      color: #FFFFFF;
    }

    .stat-meta .stat-sub {
      font-size: 20px;
      color: #94A3B8;
      margin-top: 4px;
    }

    /* Scene 5: Call To Action */
    .cta-container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    .cta-super {
      font-family: 'JetBrains Mono', monospace;
      font-size: 24px;
      font-weight: 700;
      color: #06B6D4;
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .cta-headline {
      font-size: 60px;
      font-weight: 900;
      line-height: 1.15;
      color: #FFFFFF;
    }

    .cta-box {
      width: 100%;
      background: linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%);
      padding: 32px 40px;
      border-radius: 24px;
      box-shadow: 0 20px 40px rgba(79, 70, 229, 0.4);
      margin: 10px 0;
    }

    .cta-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 42px;
      font-weight: 800;
      color: #FFFFFF;
      letter-spacing: 0.5px;
    }

    .cta-comment-sticker {
      background: rgba(255, 255, 255, 0.1);
      border: 2px dashed rgba(255, 255, 255, 0.4);
      border-radius: 18px;
      padding: 20px 32px;
      font-size: 28px;
      font-weight: 700;
      color: #F8FAFC;
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .cta-comment-sticker .key-word {
      background: #F43F5E;
      color: #FFFFFF;
      padding: 6px 16px;
      border-radius: 8px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .cta-follow {
      font-size: 26px;
      color: #94A3B8;
      font-weight: 600;
    }

    /* Subtitle Overlay Track */
    .sub-bar {
      padding: 20px 30px;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 18px;
      font-size: 28px;
      font-weight: 700;
      text-align: center;
      color: #FFFFFF;
      line-height: 1.35;
      min-height: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .sub-bar .highlight {
      color: #38BDF8;
      text-decoration: underline;
      text-underline-offset: 6px;
    }
  </style>
</head>
<body>
  <div id="stage" data-composition-id="marketing_reel" data-start="0" data-width="1080" data-height="1920">
    <div class="glow-orb-1"></div>
    <div class="glow-orb-2"></div>
    <div class="tech-grid"></div>

    <!-- Instagram Safe Zone Wrapper -->
    <div class="safe-zone">
      
      <!-- Top Brand Bar -->
      <div class="brand-header">
        <div class="brand-badge">
          <div class="dot"></div>
          <span>Signhify Studio</span>
        </div>
        <div class="live-tag">3D ENGINE • 60 FPS</div>
      </div>

      <!-- Main Animated Scene Viewport -->
      <div class="scene-viewport">
        
        <!-- SCENE 1: HOOK -->
        <div id="scene-hook" class="scene glass-card active clip" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}" data-track-index="1">
          <div class="hook-alert">⚡ {{ hook_alert|default('CRITICAL WARNING') }}</div>
          <h1 class="hook-title">{{ hook_title|default('Stop Paying $5,000 for 3D Websites') }}</h1>
          <p class="hook-sub">{{ hook_sub|default('Ship cinematic scroll-reactive 3D web pages in 10 minutes with zero code.') }}</p>
        </div>

        <!-- SCENE 2: COMPARISON (THE OLD WAY vs SIGNHIFY) -->
        <div id="scene-compare" class="scene glass-card clip" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}" data-track-index="1">
          <div class="compare-grid">
            <div class="compare-row compare-old">
              <div class="compare-label">✕ Traditional Agencies</div>
              <div class="compare-main">$5,000 & 3-4 Weeks</div>
              <div class="compare-desc">Heavy Three.js code, slow revisions, no direct export.</div>
            </div>
            <div class="compare-row compare-new">
              <div class="compare-label">✓ Signhify AI Engine</div>
              <div class="compare-main">10 Minutes & $0 Code</div>
              <div class="compare-desc">Instant 1-prompt 3D scroll, native 60 FPS, full ZIP export.</div>
            </div>
          </div>
        </div>

        <!-- SCENE 3: SHOWCASE & FEATURE -->
        <div id="scene-showcase" class="scene clip" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}" data-track-index="1">
          <div class="mockup-window">
            <div class="window-bar">
              <div class="dot-red"></div>
              <div class="dot-yellow"></div>
              <div class="dot-green"></div>
              <div class="window-url">https://signhify.dpdns.org</div>
            </div>
            <div class="mockup-content">
              <div class="feature-pill-row">
                <span class="feature-pill">Zero WebGL Code</span>
                <span class="feature-pill">60 FPS Native</span>
                <span class="feature-pill">100% MIT</span>
              </div>
              <h2 class="feature-title">{{ feature_title|default('Production Code Built From 1 Single Prompt') }}</h2>
              <ul class="feature-points">
                <li><span>▶</span> Interactive 3D camera scroll mechanics</li>
                <li><span>▶</span> Mobile-optimized hardware acceleration</li>
                <li><span>▶</span> Full HTML, CSS & Express ZIP download</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- SCENE 4: PROOF & METRICS -->
        <div id="scene-proof" class="scene glass-card clip" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}" data-track-index="1">
          <div class="stat-grid">
            <div class="stat-card">
              <div class="stat-num">+320%</div>
              <div class="stat-meta">
                <div class="stat-label">Higher Conversion</div>
                <div class="stat-sub">Compared to flat 2D landing pages</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-num">60 FPS</div>
              <div class="stat-meta">
                <div class="stat-label">Silky Smooth Scroll</div>
                <div class="stat-sub">Zero browser stutter on mobile</div>
              </div>
            </div>
            <div class="stat-card">
              <div class="stat-num">100%</div>
              <div class="stat-meta">
                <div class="stat-label">Code Ownership</div>
                <div class="stat-sub">Deploy anywhere with no lock-in</div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 5: CALL TO ACTION -->
        <div id="scene-cta" class="scene glass-card clip" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}" data-track-index="1">
          <div class="cta-container">
            <div class="cta-super">GET STARTED NOW</div>
            <h2 class="cta-headline">Build Your 3D Site Free Today</h2>
            <div class="cta-box">
              <div class="cta-url">signhify.dpdns.org</div>
            </div>
            <div class="cta-comment-sticker">
              <span>Comment <strong class="key-word">3D</strong> for direct link</span>
            </div>
            <div class="cta-follow">Follow @signhify.studio for daily AI tech architectures</div>
          </div>
        </div>

      </div>

      <!-- Spoken Caption Dynamic Bar -->
      <div id="subtitle-track" class="sub-bar clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        <span id="subtitle-text">{{ spoken_preview|default('Transform any idea into a cinematic 3D scroll website at signhify.dpdns.org') }}</span>
      </div>

    </div>

    <!-- Seekable Voiceover Audio Track -->
    {% if audio_file %}
    <audio
      data-start="0"
      data-duration="{{ total_duration }}"
      data-track-index="0"
      data-volume="1.0"
      src="{{ audio_file }}"
    ></audio>
    {% endif %}

  </div>

  <!-- GSAP 3 Seekable Timeline Script -->
  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <script>
    const sceneDurations = [
      {{ scene1_duration }},
      {{ scene2_duration }},
      {{ scene3_duration }},
      {{ scene4_duration }},
      {{ scene5_duration }}
    ];

    const scenes = [
      document.getElementById('scene-hook'),
      document.getElementById('scene-compare'),
      document.getElementById('scene-showcase'),
      document.getElementById('scene-proof'),
      document.getElementById('scene-cta')
    ];

    const tl = gsap.timeline({ paused: true });

    let cumulativeTime = 0;
    scenes.forEach((scene, idx) => {
      const dur = sceneDurations[idx];
      
      // Animate scene in
      tl.to(scene, {
        opacity: 1,
        visibility: 'visible',
        y: 0,
        scale: 1,
        duration: 0.35,
        ease: 'power3.out'
      }, cumulativeTime);

      // Micro-animations per scene
      if (idx === 0) {
        tl.from(scene.querySelector('.hook-title'), { y: 25, opacity: 0, duration: 0.4 }, cumulativeTime + 0.1);
      } else if (idx === 1) {
        tl.from(scene.querySelectorAll('.compare-row'), { y: 20, opacity: 0, stagger: 0.15, duration: 0.4 }, cumulativeTime + 0.1);
      } else if (idx === 2) {
        tl.from(scene.querySelectorAll('.feature-pill'), { scale: 0.85, opacity: 0, stagger: 0.1, duration: 0.3 }, cumulativeTime + 0.1);
      } else if (idx === 3) {
        tl.from(scene.querySelectorAll('.stat-card'), { x: -25, opacity: 0, stagger: 0.15, duration: 0.4 }, cumulativeTime + 0.1);
      } else if (idx === 4) {
        tl.from(scene.querySelector('.cta-box'), { scale: 0.9, opacity: 0, duration: 0.4, ease: 'back.out(1.5)' }, cumulativeTime + 0.1);
      }

      // Animate scene out (except for the last scene)
      if (idx < scenes.length - 1) {
        const outTime = cumulativeTime + dur - 0.25;
        tl.to(scene, {
          opacity: 0,
          y: -20,
          scale: 0.98,
          duration: 0.25,
          ease: 'power2.in'
        }, outTime);
      }

      cumulativeTime += dur;
    });

    // Register seekable timeline for HyperFrames deterministic engine
    window.__timelines = window.__timelines || {};
    window.__timelines.marketing_reel = tl;
  </script>
</body>
</html>
