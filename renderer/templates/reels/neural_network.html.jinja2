<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ topic }} — Neural Network</title>
  {% include '_kinetic_head.html.jinja2' %}
  <style>{{ theme_css|default('') }}
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background-color: #020617;
      color: #F8FAFC;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    #stage {
      position: relative;
      width: 1080px;
      height: 1920px;
      background: radial-gradient(circle at 50% 10%, #082f49 0%, #061f33 35%, #020617 82%);
      overflow: hidden;
    }

    .glow-orb-1 {
      position: absolute;
      width: 880px;
      height: 880px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(167, 139, 250, 0.26) 0%, rgba(167, 139, 250, 0) 70%);
      top: -160px;
      right: -220px;
      filter: blur(80px);
      z-index: 1;
      pointer-events: none;
    }

    .glow-orb-2 {
      position: absolute;
      width: 900px;
      height: 900px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(0, 229, 153, 0.2) 0%, rgba(0, 229, 153, 0) 70%);
      bottom: 100px;
      left: -240px;
      filter: blur(90px);
      z-index: 1;
      pointer-events: none;
    }

    .tech-grid {
      position: absolute;
      inset: 0;
      background-size: 60px 60px;
      background-image:
        linear-gradient(to right, rgba(56, 189, 248, 0.05) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(56, 189, 248, 0.05) 1px, transparent 1px);
      z-index: 2;
      pointer-events: none;
    }

    .particles {
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background-image:
        radial-gradient(2px 2px at 12% 22%, rgba(167, 139, 250, 0.9), transparent),
        radial-gradient(2px 2px at 68% 12%, rgba(56, 189, 248, 0.8), transparent),
        radial-gradient(1.5px 1.5px at 84% 42%, rgba(167, 243, 208, 0.8), transparent),
        radial-gradient(2px 2px at 32% 66%, rgba(0, 229, 153, 0.7), transparent),
        radial-gradient(1.5px 1.5px at 52% 84%, rgba(167, 139, 250, 0.7), transparent),
        radial-gradient(2px 2px at 90% 74%, rgba(56, 189, 248, 0.7), transparent);
    }

    .safe-zone {
      position: absolute;
      top: 130px;
      left: 60px;
      right: 140px;
      bottom: 330px;
      z-index: 10;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .brand-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding-bottom: 24px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      padding: 8px 24px 8px 10px;
      background: rgba(30, 27, 75, 0.55);
      border: 1.5px solid rgba(167, 139, 250, 0.7);
      border-radius: 999px;
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 1px;
      color: #FFFFFF;
      box-shadow: 0 0 24px rgba(167, 139, 250, 0.35);
    }

    .brand-header-logo {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      object-fit: cover;
      border: 1.5px solid rgba(167, 139, 250, 0.9);
      box-shadow: 0 0 16px rgba(167, 139, 250, 0.6);
    }

    .header-dot {
      width: 14px;
      height: 14px;
      background: #A78BFA;
      border-radius: 50%;
      box-shadow: 0 0 14px #A78BFA;
    }

    .live-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 20px;
      font-weight: 800;
      color: #A78BFA;
      background: rgba(167, 139, 250, 0.12);
      padding: 8px 16px;
      border-radius: 10px;
      border: 1px solid rgba(167, 139, 250, 0.4);
      letter-spacing: 1px;
    }

    .scene-viewport {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin: 30px 0;
    }

    .scene {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      opacity: 0;
      visibility: hidden;
      transform: translateY(30px) scale(0.98);
      transition: opacity 0.35s ease;
    }

    .scene.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0) scale(1);
    }

    .glass-card {
      background: rgba(10, 20, 30, 0.88);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border: 1.5px solid rgba(167, 139, 250, 0.32);
      border-radius: 36px;
      padding: 46px 42px;
      box-shadow: 0 35px 70px -15px rgba(0, 0, 0, 0.85), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    /* Hook */
    .hook-alert {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 22px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #A78BFA;
      margin-bottom: 22px;
      background: rgba(167, 139, 250, 0.16);
      border: 1px solid rgba(167, 139, 250, 0.5);
      padding: 8px 20px;
      border-radius: 12px;
      width: fit-content;
    }

    .hook-sub {
      font-size: 31px;
      font-weight: 600;
      color: #E2E8F0;
      line-height: 1.45;
      margin-top: 20px;
    }

    /* Neural canvas stage */
    .nn-stage {
      position: relative;
      width: 100%;
      height: 470px;
      border-radius: 26px;
      overflow: hidden;
      background: radial-gradient(circle at 50% 50%, rgba(56, 189, 248, 0.1) 0%, rgba(2, 6, 23, 0.4) 70%);
      border: 1.5px solid rgba(56, 189, 248, 0.3);
      box-shadow: inset 0 0 60px rgba(56, 189, 248, 0.12), 0 0 40px rgba(167, 139, 250, 0.15);
      margin-bottom: 22px;
    }

    .nn-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }

    /* Activation counters */
    .nn-counters {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }

    .nn-counter {
      flex: 1;
      background: rgba(11, 22, 34, 0.9);
      border: 1.5px solid rgba(167, 139, 250, 0.35);
      border-radius: 18px;
      padding: 18px 12px;
      text-align: center;
    }

    .nn-counter .nn-counter-num {
      font-family: 'JetBrains Mono', monospace;
      font-size: 44px;
      font-weight: 900;
      background: linear-gradient(135deg, #A78BFA, #38BDF8);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }

    .nn-counter .nn-counter-label {
      font-size: 19px;
      font-weight: 700;
      color: #94A3B8;
      margin-top: 6px;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    /* Scene body headline: kinetic, 3D extruded, headline ONLY (no narration) */
    .scene-headline {
      margin-bottom: 22px;
    }

    /* Subtitle track */
    .sub-container {
      position: relative;
      height: 95px;
      width: 100%;
    }

    .sub-bar {
      position: absolute;
      inset: 0;
      padding: 16px 28px;
      background: rgba(2, 6, 23, 0.92);
      backdrop-filter: blur(16px);
      border: 1.5px solid rgba(167, 139, 250, 0.45);
      border-radius: 20px;
      font-size: 26px;
      font-weight: 800;
      text-align: center;
      color: #FFFFFF;
      line-height: 1.35;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.8);
      opacity: 0;
      visibility: hidden;
    }

    .sub-bar.active {
      opacity: 1;
      visibility: visible;
    }

    /* Stat rows (proof) */
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 22px;
    }

    .stat-card {
      background: rgba(11, 22, 34, 0.9);
      border: 1.5px solid rgba(167, 139, 250, 0.4);
      border-radius: 26px;
      padding: 30px 38px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .stat-num {
      font-size: 72px;
      font-weight: 900;
      letter-spacing: -2px;
      background: linear-gradient(135deg, #A78BFA, #38BDF8);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      line-height: 1;
    }

    .stat-meta { text-align: right; }

    .stat-meta .stat-label {
      font-size: 29px;
      font-weight: 900;
      color: #FFFFFF;
    }

    .stat-meta .stat-sub {
      font-size: 21px;
      color: #94A3B8;
      margin-top: 4px;
    }

    /* CTA */
    .cta-container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
    }

    .cta-super {
      font-family: 'JetBrains Mono', monospace;
      font-size: 28px;
      font-weight: 900;
      color: #A78BFA;
      letter-spacing: 3px;
      text-transform: uppercase;
      text-shadow: 0 0 20px rgba(167, 139, 250, 0.5);
    }

    .cta-headline {
      font-size: 54px;
      font-weight: 900;
      line-height: 1.15;
      color: #FFFFFF;
      text-shadow: 0 4px 20px rgba(0, 0, 0, 0.9);
    }

    .cta-box {
      width: 100%;
      background: linear-gradient(135deg, #A78BFA 0%, #38BDF8 100%);
      padding: 30px 38px;
      border-radius: 24px;
      box-shadow: 0 20px 50px rgba(167, 139, 250, 0.45);
      margin: 6px 0;
    }

    .cta-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 42px;
      font-weight: 900;
      color: #020617;
      letter-spacing: 0.5px;
    }

    .cta-comment-sticker {
      background: rgba(255, 255, 255, 0.1);
      border: 2px dashed rgba(167, 139, 250, 0.7);
      border-radius: 20px;
      padding: 18px 34px;
      font-size: 29px;
      font-weight: 800;
      color: #F8FAFC;
    }

    .cta-comment-sticker .key-word {
      background: #A78BFA;
      color: #020617;
      padding: 8px 22px;
      border-radius: 12px;
      font-weight: 900;
      letter-spacing: 1px;
    }

    .cta-follow {
      font-size: 25px;
      color: #CBD5E1;
      font-weight: 700;
    }
  </style>
</head>
<body>
  <div id="stage" data-composition-id="neural_network_reel" data-start="0" data-width="1080" data-height="1920" data-fps="25">
    <div class="glow-orb-1" id="orb-1"></div>
    <div class="glow-orb-2" id="orb-2"></div>
    <div class="tech-grid" id="bg-grid"></div>
    <div class="particles" id="stars"></div>

    <div class="safe-zone">

      <div class="brand-header">
        <div class="brand-badge">
          {% if logo_file %}
          <img src="{{ logo_file }}" class="brand-header-logo" alt="Signhify Logo" />
          {% else %}
          <div class="header-dot"></div>
          {% endif %}
          <span>Signhify Studio</span>
        </div>
        <div class="live-tag">NEURAL ENGINE • LIVE</div>
      </div>

      <div class="scene-viewport">

        <!-- SCENE 1: HOOK -->
        <div id="scene-hook" class="scene active clip" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}" data-track-index="1">
          <div class="glass-card">
            <div class="hook-alert">⚡ {{ hook_alert|default('SYSTEM ACTIVATION') }}</div>
            <h1 class="kinetic-text kt-3d kt-size-xl scene-headline" data-kinetic="letters" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}">{{ hook_title }}</h1>
            <p class="hook-sub">{{ scene1_headline|default('') }}</p>
          </div>
        </div>

        <!-- SCENE 2: NEURAL SHOWCASE (activation moment) -->
        <div id="scene-neural" class="scene clip" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}" data-track-index="1">
          <div class="glass-card">
            <h2 class="kinetic-text kt-3d kt-size-md scene-headline" data-kinetic="letters" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}">{{ scene2_headline|default('') }}</h2>
            <div class="nn-stage">
              <canvas id="nn-canvas" class="nn-canvas" width="1080" height="720"></canvas>
            </div>
            <div class="nn-counters">
              <div class="nn-counter"><div class="nn-counter-num" id="nn-count-1">0</div><div class="nn-counter-label">Nodes</div></div>
              <div class="nn-counter"><div class="nn-counter-num" id="nn-count-2">0</div><div class="nn-counter-label">Layers</div></div>
              <div class="nn-counter"><div class="nn-counter-num" id="nn-count-3">0</div><div class="nn-counter-label">Synapses</div></div>
            </div>
          </div>
        </div>

        <!-- SCENE 3: ARCHITECTURE -->
        <div id="scene-architecture" class="scene clip" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}" data-track-index="1">
          <div class="glass-card">
            <h2 class="kinetic-text kt-3d kt-size-md scene-headline" data-kinetic="letters" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}">{{ scene3_headline|default('') }}</h2>
            <div class="nn-stage">
              <canvas id="nn-canvas-2" class="nn-canvas" width="1080" height="720"></canvas>
            </div>
          </div>
        </div>

        <!-- SCENE 4: PROOF -->
        <div id="scene-proof" class="scene clip" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}" data-track-index="1">
          <div class="glass-card">
            <h2 class="kinetic-text kt-3d kt-size-md scene-headline" data-kinetic="letters" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}">{{ scene4_headline|default('') }}</h2>
            <div class="stat-grid">
              <div class="stat-card">
                <div class="stat-num">{{ proof_metric|default('1M') }}</div>
                <div class="stat-meta">
                  <div class="stat-label">Neural Synapses</div>
                  <div class="stat-sub">Per trained model</div>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-num">1000×</div>
                <div class="stat-meta">
                  <div class="stat-label">Faster Inference</div>
                  <div class="stat-sub">vs brute-force compute</div>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-num">99.9%</div>
                <div class="stat-meta">
                  <div class="stat-label">Uptime</div>
                  <div class="stat-sub">Production-grade runtime</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- SCENE 5: CTA -->
        <div id="scene-cta" class="scene clip" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}" data-track-index="1">
          <div class="glass-card">
            <div class="cta-container">
              <div class="cta-super">SIGNHIFY STUDIO</div>
              <h2 class="kinetic-text kt-3d kt-size-md cta-headline" data-kinetic="letters" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}">{{ scene5_headline|default('') }}</h2>
              <div class="cta-box">
                <div class="cta-url">signhify.dpdns.org</div>
              </div>
              <div class="cta-comment-sticker">
                <span>Comment <strong class="key-word">AI</strong> for direct link</span>
              </div>
              <div class="cta-follow">Follow @signhify.studio for daily AI architectures</div>
            </div>
          </div>
        </div>

      </div>

      <!-- Spoken Caption Track (single narration layer, synced per scene) -->
      <div class="sub-container">
        <div id="sub-1" class="sub-bar clip" data-start="{{ scene1_start }}" data-duration="{{ scene1_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene1_narration }}"</span>
        </div>
        <div id="sub-2" class="sub-bar clip" data-start="{{ scene2_start }}" data-duration="{{ scene2_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene2_narration }}"</span>
        </div>
        <div id="sub-3" class="sub-bar clip" data-start="{{ scene3_start }}" data-duration="{{ scene3_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene3_narration }}"</span>
        </div>
        <div id="sub-4" class="sub-bar clip" data-start="{{ scene4_start }}" data-duration="{{ scene4_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene4_narration }}"</span>
        </div>
        <div id="sub-5" class="sub-bar clip" data-start="{{ scene5_start }}" data-duration="{{ scene5_duration }}" data-track-index="2">
          <span class="sub-text">"{{ scene5_narration }}"</span>
        </div>
      </div>

    </div>

    {% if audio_file %}
    <audio
      data-start="0"
      data-duration="{{ total_duration }}"
      data-track-index="0"
      data-volume="1.0"
      src="{{ audio_file }}"
    ></audio>
    {% endif %}

  </div>

  <script src="https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js"></script>
  <script>
    // ── Neural network canvas (deterministic: static layout, GSAP-seekable pulses)
    // Fixed 4-layer topology with known node positions; signal pulses are DOM
    // elements animated on the timeline so seek() reproduces any frame exactly.
    (function () {
      function buildNet(canvas, opts) {
        if (!canvas || !canvas.getContext) return null;
        var ctx = canvas.getContext('2d');
        var W = canvas.width, H = canvas.height;
        var layers = opts.layers || [1, 10, 100, 1000];
        var colors = opts.colors || ['#A78BFA', '#38BDF8', '#00E599'];
        var nodes = [];
        var edges = [];
        var lc = layers.length;
        for (var li = 0; li < lc; li++) {
          var n = layers[li];
          var col = Math.round(W * (li + 0.5) / lc);
          for (var ni = 0; ni < n; ni++) {
            var row = (ni + 0.5) / n;
            nodes.push({ x: col, y: 30 + row * (H - 60), layer: li });
          }
        }
        // connect consecutive layers
        for (var a = 0; a < lc - 1; a++) {
          var left = nodes.filter(function (d) { return d.layer === a; });
          var right = nodes.filter(function (d) { return d.layer === a + 1; });
          for (var i = 0; i < left.length; i += Math.max(1, Math.floor(left.length / 8))) {
            for (var j = 0; j < right.length; j += Math.max(1, Math.floor(right.length / 8))) {
              edges.push({ a: left[i], b: right[j] });
            }
          }
        }
        return { ctx: ctx, W: W, H: H, nodes: nodes, edges: edges, colors: colors };
      }

      function drawNet(net) {
        var ctx = net.ctx;
        ctx.clearRect(0, 0, net.W, net.H);
        // edges
        ctx.lineWidth = 1.2;
        net.edges.forEach(function (e) {
          ctx.strokeStyle = 'rgba(56, 189, 248, 0.22)';
          ctx.beginPath();
          ctx.moveTo(e.a.x, e.a.y);
          ctx.lineTo(e.b.x, e.b.y);
          ctx.stroke();
        });
        // nodes
        net.nodes.forEach(function (d) {
          var c = net.colors[d.layer % net.colors.length];
          var r = 3 + (d.layer % 3) * 1.4;
          ctx.beginPath();
          ctx.arc(d.x, d.y, r, 0, Math.PI * 2);
          ctx.fillStyle = c;
          ctx.shadowColor = c;
          ctx.shadowBlur = 12;
          ctx.fill();
          ctx.shadowBlur = 0;
        });
      }

      var net1 = buildNet(document.getElementById('nn-canvas'), { layers: [1, 10, 100, 1000] });
      if (net1) drawNet(net1);
      var net2 = buildNet(document.getElementById('nn-canvas-2'), { layers: [10, 40, 80, 40, 10] });
      if (net2) drawNet(net2);
      // expose for the timeline to draw signal pulses
      window.__nnNets = [net1, net2];
    })();
  </script>
  <script>
    const sceneDurations = [
      {{ scene1_duration }},
      {{ scene2_duration }},
      {{ scene3_duration }},
      {{ scene4_duration }},
      {{ scene5_duration }}
    ];

    const scenes = [
      document.getElementById('scene-hook'),
      document.getElementById('scene-neural'),
      document.getElementById('scene-architecture'),
      document.getElementById('scene-proof'),
      document.getElementById('scene-cta')
    ];

    const subtitles = [
      document.getElementById('sub-1'),
      document.getElementById('sub-2'),
      document.getElementById('sub-3'),
      document.getElementById('sub-4'),
      document.getElementById('sub-5')
    ];

    const orb1 = document.getElementById('orb-1');
    const orb2 = document.getElementById('orb-2');
    const stars = document.getElementById('stars');
    if (stars) gsap.to(stars, { y: -60, duration: {{ total_duration }}, ease: 'none' });

    const tl = gsap.timeline({ paused: true });

    // Deterministic signal pulses along the neural edges (DOM dots tweened
    // along the timeline, so they seek exactly like everything else). Canvas
    // coords (1080x720) are scaled into the CSS-sized .nn-stage container.
    function addPulses(timeline, at, dur, count, stageSel, netIdx) {
      var net = (window.__nnNets || [null])[netIdx || 0];
      var stage = document.querySelector(stageSel);
      if (!net || !net.edges.length || !stage) return;
      var sx = stage.clientWidth / 1080;
      var sy = stage.clientHeight / 720;
      for (var p = 0; p < count; p++) {
        var e = net.edges[p % net.edges.length];
        var dot = document.createElement('div');
        dot.style.cssText = 'position:absolute;width:12px;height:12px;border-radius:50%;' +
          'background:#00E599;box-shadow:0 0 16px #00E599, 0 0 40px rgba(0,229,153,0.6);' +
          'z-index:5;pointer-events:none;left:' + (e.a.x * sx) + 'px;top:' + (e.a.y * sy) + 'px;';
        stage.appendChild(dot);
        timeline.fromTo(dot, { left: e.a.x * sx, top: e.a.y * sy }, {
          left: e.b.x * sx, top: e.b.y * sy, duration: dur * 0.75, ease: 'none'
        }, at + p * (dur / (count * 2)));
      }
    }

    let cumulativeTime = 0;
    scenes.forEach((scene, idx) => {
      const dur = sceneDurations[idx];
      const sub = subtitles[idx];

      tl.to(scene, {
        opacity: 1,
        visibility: 'visible',
        y: 0,
        scale: 1,
        duration: 0.35,
        ease: 'power3.out'
      }, cumulativeTime);

      if (sub) {
        tl.to(sub, {
          opacity: 1,
          visibility: 'visible',
          duration: 0.28,
          ease: 'power2.out'
        }, cumulativeTime);
      }

      // Orb drift + per-scene accent
      if (idx === 0) {
        tl.to(orb1, { x: -60, y: 90, scale: 1.2, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.to(orb2, { x: 60, y: -70, scale: 1.1, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
      } else if (idx === 1) {
        // System activation: 1 -> 10 -> 100 -> 1000 counters
        const c1 = document.getElementById('nn-count-1');
        const c2 = document.getElementById('nn-count-2');
        const c3 = document.getElementById('nn-count-3');
        if (c1) tl.fromTo(c1, { innerText: 0 }, { innerText: 1000, duration: dur * 0.6, ease: 'power1.in', snap: { innerText: 1 } }, cumulativeTime + dur * 0.1);
        if (c2) tl.fromTo(c2, { innerText: 0 }, { innerText: 4, duration: dur * 0.5, ease: 'power1.in', snap: { innerText: 1 } }, cumulativeTime + dur * 0.15);
        if (c3) tl.fromTo(c3, { innerText: 0 }, { innerText: 24000, duration: dur * 0.7, ease: 'power1.in', snap: { innerText: 1 } }, cumulativeTime + dur * 0.2);
        addPulses(tl, cumulativeTime + dur * 0.2, dur * 0.6, 6, '#scene-neural .nn-stage', 0);
        tl.to(orb1, { x: 80, y: 160, scale: 1.3, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.to(orb2, { x: -90, y: 40, scale: 1.3, duration: dur, ease: 'power2.out' }, cumulativeTime);
      } else if (idx === 2) {
        addPulses(tl, cumulativeTime + dur * 0.2, dur * 0.6, 4, '#scene-architecture .nn-stage', 1);
        tl.to(orb1, { x: -110, y: -40, scale: 1.4, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
        tl.to(orb2, { x: 100, y: 140, scale: 1.1, duration: dur, ease: 'sine.inOut' }, cumulativeTime);
      } else if (idx === 3) {
        tl.from(scene.querySelectorAll('.stat-card'), { x: -25, opacity: 0, stagger: dur * 0.08, duration: dur * 0.25 }, cumulativeTime + dur * 0.06);
        tl.to(orb1, { x: 40, y: -90, scale: 1.25, duration: dur, ease: 'power2.out' }, cumulativeTime);
        tl.to(orb2, { x: -80, y: 60, scale: 1.35, duration: dur, ease: 'power2.out' }, cumulativeTime);
      } else if (idx === 4) {
        tl.to(orb1, { x: 0, y: 0, scale: 1.5, duration: dur, ease: 'sine.out' }, cumulativeTime);
        tl.to(orb2, { x: 0, y: 0, scale: 1.5, duration: dur, ease: 'sine.out' }, cumulativeTime);
        tl.from(scene.querySelector('.cta-box'), { scale: 0.9, opacity: 0, duration: dur * 0.2, ease: 'back.out(1.5)' }, cumulativeTime + dur * 0.16);
        tl.from(scene.querySelector('.cta-comment-sticker'), { y: 15, opacity: 0, duration: dur * 0.2 }, cumulativeTime + dur * 0.22);
      }

      // Apply shared kinetic-type animation to this scene's headline(s)
      window.KineticText.applyKineticText(scene, tl);

      if (idx < scenes.length - 1) {
        const outTime = cumulativeTime + dur - 0.25;
        tl.to(scene, {
          opacity: 0,
          y: -20,
          scale: 0.98,
          duration: 0.25,
          ease: 'power2.in'
        }, outTime);
        if (sub) {
          tl.to(sub, {
            opacity: 0,
            duration: 0.22,
            ease: 'power2.in'
          }, outTime);
        }
      }

      cumulativeTime += dur;
    });

    // Register seekable timeline for HyperFrames deterministic engine
    window.__timelines = window.__timelines || {};
    window.__timelines.neural_network_reel = tl;
  </script>
</body>
</html>
