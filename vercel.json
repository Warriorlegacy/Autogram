{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://autogram-dashboard.onrender.com/api/$1"
    },
    {
      "source": "/output/(.*)",
      "destination": "https://autogram-dashboard.onrender.com/output/$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
