# Copy to .env (never commit .env). Only needed for the voice provider you use.
OPENAI_API_KEY=
# Optional: OpenAI-compatible endpoint (default https://api.openai.com/v1)
# OPENAI_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional: force a browser for Remotion if its own headless Chrome fails
# BROWSER_EXECUTABLE=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
